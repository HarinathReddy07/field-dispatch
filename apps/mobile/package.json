{
  "name": "@dispatch/mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@dispatch/contracts": "workspace:*",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@tanstack/react-query": "^5.104.1",
    "expo": "~57.0.27",
    "expo-build-properties": "~57.0.22",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "socket.io-client": "^4.8.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "^57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "bundle": "expo export --platform android --output-dir dist-bundle"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@dispatch/contracts$": "<rootDir>/../../packages/contracts/src"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg))",
      "/node_modules/react-native-reanimated/plugin/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist-bundle/"
    ],
    "testTimeout": 120000
  }
}
