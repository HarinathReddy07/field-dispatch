{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "TEST_ADMIN_DATABASE_URL",
    "TEST_REDIS_URL",
    "DOCKER_HOST",
    "TESTCONTAINERS_HOST_OVERRIDE",
    "TESTCONTAINERS_RYUK_DISABLED",
    "CONCURRENCY_ITERATIONS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "css/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    }
  },
  "agentGuidance": false
}
