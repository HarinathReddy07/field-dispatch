# Field Dispatch: every environment variable, with a safe local-development value.
#
# `make up` creates .env from this file automatically and replaces every CHANGE_ME_* placeholder with a freshly
# generated random value (infra/scripts/init-env.js). To do it by hand:  cp .env.example .env  and edit.
# NEVER commit .env. Secrets can be generated with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# ---------------------------------------------------------------- runtime
NODE_ENV=development
# Port the API listens on inside its container / process.
PORT=3000
# Host ports published by docker compose.
API_PORT=3000
ADMIN_PORT=3001

# ---------------------------------------------------------------- transport (HTTPS/WSS)
# true  = plain HTTP/WS is accepted. LOCAL DEVELOPMENT AND THE TRIAL docker-compose.yml ONLY.
# false = deployable profile: the API answers 426 to plain HTTP, refuses plain WS handshakes, and requires https
#         CORS origins. TLS is terminated by a reverse proxy (infra/docker-compose.tls.yml, docs/deploy-tls.md).
INSECURE_LOCAL_DEV=true

# ---------------------------------------------------------------- PostgreSQL + PostGIS (system of record)
POSTGRES_USER=dispatch
POSTGRES_PASSWORD=CHANGE_ME_dev_password
POSTGRES_DB=dispatch
POSTGRES_PORT=5432
# Host-side URL (migrations/seed/tests run from the host). docker compose overrides the host name for containers.
DATABASE_URL=postgres://dispatch:CHANGE_ME_dev_password@localhost:5432/dispatch

# ---------------------------------------------------------------- Redis (OTP/idempotency hints, presence, throttling, socket fan-out)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------- authentication
# HS256 signing secret for access tokens (>= 32 chars).
JWT_ACCESS_SECRET=CHANGE_ME_at_least_32_characters_long_secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# ---------------------------------------------------------------- arrival OTP
# Key for the HMAC stored instead of the OTP (>= 32 chars). The OTP itself is never stored or logged.
OTP_HMAC_SECRET=CHANGE_ME_another_32_characters_long_secret
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LOCK_SECONDS=300

# ---------------------------------------------------------------- dispatch
SEARCH_RADIUS_KM=15
# Technicians whose last_seen_at is older than this are excluded from matching.
# Generous for local demos so seeded technicians stay "fresh"; use 300 in production-like runs.
LOCATION_FRESHNESS_SECONDS=3600
LOCATION_PERSIST_INTERVAL_SECONDS=30

# ---------------------------------------------------------------- review timeout / background loops
# TR-10: auto-approve an unreviewed job after this many seconds. Spec default 600 (10 minutes); `make demo` uses 60.
REVIEW_TIMEOUT_SECONDS=600
SWEEPER_INTERVAL_MS=5000
OUTBOX_POLL_MS=500
# Outbox publisher + review sweeper loops (true in every real run; tests may drive them manually).
BACKGROUND_JOBS=true

# ---------------------------------------------------------------- HTTP surface
# Comma-separated browser origins allowed by CORS. No wildcard. Must be https:// when INSECURE_LOCAL_DEV=false.
CORS_ORIGINS=http://localhost:3001
# Requests per minute per subject (IP / user / login email). Login and OTP arrival fail CLOSED if Redis is down.
THROTTLE_LOGIN_PER_MIN=10
THROTTLE_ARRIVE_PER_MIN=10
THROTTLE_DEFAULT_PER_MIN=300
# OpenAPI/Swagger UI at /api/docs. Off unless set to true.
SWAGGER_ENABLED=false

# ---------------------------------------------------------------- admin console (Next.js)
# Address the BROWSER uses to reach the API (Socket.io). The admin server itself calls the API at API_INTERNAL_URL.
PUBLIC_API_URL=http://localhost:3000
# Used when the admin runs outside docker compose (compose sets http://api:3000).
API_INTERNAL_URL=http://localhost:3000
# Session cookies are Secure by default. false = plain-HTTP local demo only.
ADMIN_COOKIE_SECURE=false

# ---------------------------------------------------------------- object storage (S3-compatible, RustFS in docker compose; PRIVATE bucket)
S3_ENDPOINT=http://localhost:9000
# Address devices/browsers use in presigned URLs (a phone needs the host's LAN address, https in a deployable profile).
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dispatch-evidence
S3_ACCESS_KEY=CHANGE_ME_storage_access
S3_SECRET_KEY=CHANGE_ME_storage_secret_key
S3_PRESIGN_TTL_SECONDS=300
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
# minio = the S3-compatible adapter (works with RustFS, MinIO, AWS S3) | memory = in-process MOCK for tests only
STORAGE_PROVIDER=minio

# ---------------------------------------------------------------- demo seed (infra/seed/seed.js)
# Shared password for every seeded demo account. Local/trial only; never reuse anywhere else.
SEED_PASSWORD=Passw0rd!dev

# ---------------------------------------------------------------- mobile app (Expo)
# Android emulator: http://10.0.2.2:3000 | iOS simulator: http://localhost:3000 | phone: http://<host LAN ip>:3000
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# ---------------------------------------------------------------- automated tests (all optional)
# Point the suites at running PostgreSQL+PostGIS / Redis / S3-compatible instances instead of letting
# Testcontainers start containers. The admin database role must be able to CREATE DATABASE and CREATE EXTENSION.
# TEST_ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# TEST_REDIS_URL=redis://localhost:6379
# TEST_S3_ENDPOINT=http://localhost:9000
# TEST_S3_ACCESS_KEY=...
# TEST_S3_SECRET_KEY=...
# Iterations for the repeated concurrency loops (default 20).
# CONCURRENCY_ITERATIONS=20
