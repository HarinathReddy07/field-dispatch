# Field Dispatch: Environment Configuration Example
# Production-ready configuration with MongoDB database and role-based demo credentials.

# ---------------------------------------------------------------- runtime
NODE_ENV=development
PORT=3000
API_PORT=3000
ADMIN_PORT=3001

# ---------------------------------------------------------------- transport (HTTPS/WSS)
INSECURE_LOCAL_DEV=true

# ---------------------------------------------------------------- Database: MongoDB (System of Record)
DATABASE_TYPE=mongodb
MONGODB_URI=mongodb://localhost:27017/field_dispatch
MONGODB_DB=field_dispatch
DATABASE_URL=mongodb://localhost:27017/field_dispatch

# Optional fallback: PostgreSQL + PostGIS configuration
# POSTGRES_USER=dispatch
# POSTGRES_PASSWORD=CHANGE_ME_dev_password
# POSTGRES_DB=dispatch
# POSTGRES_PORT=5432
# POSTGRES_DATABASE_URL=postgres://dispatch:CHANGE_ME_dev_password@localhost:5432/dispatch

# ---------------------------------------------------------------- Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------- authentication
JWT_ACCESS_SECRET=CHANGE_ME_jwt_secret_at_least_32_chars_long
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# ---------------------------------------------------------------- arrival OTP
OTP_HMAC_SECRET=CHANGE_ME_otp_hmac_secret_at_least_32_chars_long
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LOCK_SECONDS=300

# ---------------------------------------------------------------- dispatch
SEARCH_RADIUS_KM=15
LOCATION_FRESHNESS_SECONDS=3600
LOCATION_PERSIST_INTERVAL_SECONDS=30

# ---------------------------------------------------------------- review timeout / background jobs
REVIEW_TIMEOUT_SECONDS=600
SWEEPER_INTERVAL_MS=5000
OUTBOX_POLL_MS=500
BACKGROUND_JOBS=true

# ---------------------------------------------------------------- HTTP surface
CORS_ORIGINS=http://localhost:3001
THROTTLE_LOGIN_PER_MIN=10
THROTTLE_ARRIVE_PER_MIN=10
THROTTLE_DEFAULT_PER_MIN=300
SWAGGER_ENABLED=false

# ---------------------------------------------------------------- admin console (Next.js)
PUBLIC_API_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:3000
ADMIN_COOKIE_SECURE=false

# ---------------------------------------------------------------- object storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dispatch-evidence
S3_ACCESS_KEY=CHANGE_ME_s3_key
S3_SECRET_KEY=CHANGE_ME_s3_secret
S3_PRESIGN_TTL_SECONDS=300
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
STORAGE_PROVIDER=minio

# ==============================================================================
# DEMO CREDENTIALS FOR EACH ROLE (Customer, Technician, Admin)
# ==============================================================================
SEED_PASSWORD=Passw0rd!dev

# Role 1: Customer / Requester (Portal: /app)
DEMO_CUSTOMER_EMAIL=requester1@dispatch.test
DEMO_CUSTOMER_PASSWORD=Passw0rd!dev
NEXT_PUBLIC_DEMO_CUSTOMER_EMAIL=requester1@dispatch.test
NEXT_PUBLIC_DEMO_CUSTOMER_PASSWORD=Passw0rd!dev

# Role 2: Field Technician (Portal: /tech)
DEMO_TECH_EMAIL=tech1@dispatch.test
DEMO_TECH_PASSWORD=Passw0rd!dev
NEXT_PUBLIC_DEMO_TECH_EMAIL=tech1@dispatch.test
NEXT_PUBLIC_DEMO_TECH_PASSWORD=Passw0rd!dev

# Role 3: Operations Administrator (Portal: /admin)
DEMO_ADMIN_EMAIL=admin@dispatch.test
DEMO_ADMIN_PASSWORD=Passw0rd!dev
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=admin@dispatch.test
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=Passw0rd!dev

# ---------------------------------------------------------------- mobile app (Expo)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
