# Copy to .env and replace every CHANGE_ME. NEVER commit .env.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

NODE_ENV=development
PORT=3000

# --- PostgreSQL (PostGIS). Host-side URL; docker compose overrides the host for the api container. ---
POSTGRES_USER=dispatch
POSTGRES_PASSWORD=CHANGE_ME_dev_password
POSTGRES_DB=dispatch
POSTGRES_PORT=5432
DATABASE_URL=postgres://dispatch:CHANGE_ME_dev_password@localhost:5432/dispatch

# --- Redis (throttling, OTP/idempotency hints, presence, socket adapter) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Auth ---
# HS256 signing secret for access tokens (>= 32 chars).
JWT_ACCESS_SECRET=CHANGE_ME_at_least_32_characters_long_secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# --- OTP ---
# Secret key for the HMAC stored in place of the OTP (>= 32 chars).
OTP_HMAC_SECRET=CHANGE_ME_another_32_characters_long_secret
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LOCK_SECONDS=300

# --- Dispatch ---
SEARCH_RADIUS_KM=15
# Technicians whose last_seen_at is older than this are excluded from matching.
# Dev default is generous so seeded technicians stay "fresh" during a demo; use 300 in production-like runs.
LOCATION_FRESHNESS_SECONDS=3600
LOCATION_PERSIST_INTERVAL_SECONDS=30

# --- Review timeout / sweeper ---
# Spec default is 10 minutes (600). `make demo` overrides this to 60.
REVIEW_TIMEOUT_SECONDS=600
SWEEPER_INTERVAL_MS=5000
OUTBOX_POLL_MS=500

# --- HTTP ---
# Comma-separated list of allowed browser origins. No wildcard.
CORS_ORIGINS=http://localhost:3001
API_PORT=3000
ADMIN_PORT=3001
# Address the BROWSER uses to reach the API (Socket.io). The admin server calls the API via http://api:3000.
PUBLIC_API_URL=http://localhost:3000
# Admin session cookies are Secure by default in production. false = plain-HTTP local demo only.
ADMIN_COOKIE_SECURE=false
THROTTLE_LOGIN_PER_MIN=10
THROTTLE_ARRIVE_PER_MIN=10
THROTTLE_DEFAULT_PER_MIN=300
SWAGGER_ENABLED=true
# Outbox publisher + review sweeper loops (true in all real runs)
BACKGROUND_JOBS=true

# --- Object storage (MinIO, S3-compatible, private bucket) ---
S3_ENDPOINT=http://localhost:9000
# Host clients use to reach MinIO in presigned URLs (device/emulator reachable address).
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dispatch-evidence
S3_ACCESS_KEY=CHANGE_ME_minio_access
S3_SECRET_KEY=CHANGE_ME_minio_secret_key
S3_PRESIGN_TTL_SECONDS=300
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# minio | memory (memory = in-process MOCK storage, tests only)
STORAGE_PROVIDER=minio

# --- Dev seed ---
# Shared dev-only password for all seeded demo accounts (see README). Never use outside local/trial.
SEED_PASSWORD=Passw0rd!dev
